<?xml version="1.0" encoding="utf-8"?>
<!-- KB-406 S1 (D111): Android 12+ - the shop's bills, customers and sign-in session never go to Google's cloud backup or to a new phone
     by device transfer; the server is the copy that is backed up (D75), and a new phone signs in and pulls. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
