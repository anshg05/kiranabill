{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/scripts.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
