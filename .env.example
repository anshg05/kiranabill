GROQ_API_KEY=API_KEY_HERE
GEMINI_API_KEY=API_KEY_HERE
# Vite only exposes VITE_-prefixed vars to client-side code (checked against
# vite.config.ts - no custom envPrefix is set, so this is not optional).
# Never add the service role key here, even with a VITE_ prefix - it would
# get bundled into client-shipped JS. Nothing in this project uses it (/voice
# authenticates with the caller's JWT + RLS), so it goes nowhere - not this
# file, not .env.local, not Netlify (17-MANUAL-TASKS.md M-10 step 5, M-13).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
ALLOWED_ORIGIN=https://your-site.netlify.app
LEARNING_BLOB_STORE=kiranabill-learning
# Optional local-dev fallback file path
LEARNING_SYNC_FILE_PATH=netlify/functions/.learning-sync-store.json
PORT=8888
