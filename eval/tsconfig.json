{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/eval.tsbuildinfo",
    "skipLibCheck": true,

    /* KB-317: eval runs the SHIPPED routing (src/data/voiceBilling.ts), which imports via @/ */
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["*.ts"]
}
